{ config, ... }:  {
  # import our dconf settings that have been autogenerated
  # TODO(emily): Move this all to personal-config
  imports = [ ./dconf.nix ];

  config = {
    # utilize dconf2nix to allow us to cache any dconf changes we make
    # this gives is the ability to make updates through the gnome UI, then record them automatically
    # into nix config
    home.shellAliases =
      let
        # TODO(emily): argument this more
        dconf-nix-file = "/home/${config.main-user.user-name}/config/emily-pc/home/de/gnome/dconf.nix";
      in
      {
        generate-dconf = "dconf dump / | nix run nixpkgs#dconf2nix > ${dconf-nix-file}";
      };
  };

}
